# Copie para .env e preencha. Nunca versione o .env.

# --- Banco (use um usuario SOMENTE LEITURA: veja grant_readonly.sql) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smarttennis_dashboard
DB_PASSWORD=
DB_NAME=smarttennis_backend
DB_SSL=true
# Fuso em que o MySQL grava os TIMESTAMP (criado_em, recebido_em). Em nuvem costuma ser UTC.
DB_TIMESTAMP_TZ=UTC

# --- API do backend (health check e modo "uma conta") ---
API_URL=http://127.0.0.1:5001

# --- Opcional: exige senha para abrir o dashboard (ele mostra dados pessoais) ---
DASHBOARD_PASSWORD=
