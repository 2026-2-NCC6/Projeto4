# Copie para .env e preencha. Nunca versione o .env.

# --- API do backend (o dashboard NÃO acessa o banco) ---
API_URL=http://127.0.0.1:5001
# Mesmo valor de DASHBOARD_API_KEY no .env do backend. Gere com: openssl rand -hex 32
DASHBOARD_API_KEY=

# --- Opcional: exige senha para abrir o dashboard (ele mostra dados pessoais) ---
DASHBOARD_PASSWORD=
