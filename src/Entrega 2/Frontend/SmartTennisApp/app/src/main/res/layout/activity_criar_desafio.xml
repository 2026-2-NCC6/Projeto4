<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollCriarDesafio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnCancelarDesafio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_back_button"
                android:contentDescription="Voltar"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/setavoltar"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/txtTituloCriarDesafio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Criar desafio"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Crie sua missão, escolha os golpes e ganhe XP ao executá-la com a raquete SmartTennis."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView style="@style/DesafioCampoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nome do desafio" />
        <EditText
            android:id="@+id/edtNomeDesafio"
            style="@style/DesafioCampo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ex.: Sequência de consistência"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:singleLine="true" />

        <TextView style="@style/DesafioCampoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Descrição (opcional)" />
        <EditText
            android:id="@+id/edtDescricaoDesafio"
            style="@style/DesafioCampo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:gravity="top|start"
            android:hint="Qual habilidade você quer praticar?"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:maxLines="4" />

        <TextView style="@style/DesafioCampoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Duração máxima (minutos)" />
        <EditText
            android:id="@+id/edtDuracaoDesafio"
            style="@style/DesafioCampo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ex.: 10"
            android:inputType="number"
            android:maxLength="2"
            android:singleLine="true" />

        <TextView style="@style/DesafioCampoLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dificuldade" />
        <Spinner
            android:id="@+id/spnDificuldadeDesafio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_busca_treino"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card_treino_execucao"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ COMEÇAR COM UM PRESET"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Escolha uma base pronta e depois personalize os golpes."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPresetRitmo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_accent_dark"
                    android:minWidth="0dp"
                    android:text="⚡ Ritmo"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPresetRali"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_accent_dark"
                    android:minWidth="0dp"
                    android:text="🔥 Rally"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPresetSaque"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/surface_accent_dark"
                    android:minWidth="0dp"
                    android:text="🎯 Saque"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SEQUÊNCIA DE GOLPES"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Monte a ordem dos movimentos. Cada acerto vale 100 pontos; a cada 3 golpes corretos seguidos você ganha +50 pontos de combo."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spnGolpeDesafio"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_busca_treino"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnAdicionarEtapaDesafio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/accent"
            android:text="Adicionar golpe à sequência"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtContadorEtapasDesafio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nenhum golpe adicionado (limite: 50)"
            android:textColor="#D5DCE2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSequenciaDesafio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_treino_execucao"
            android:minHeight="64dp"
            android:padding="14dp"
            android:text="Sua sequência aparecerá aqui."
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRemoverEtapaDesafio"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_secondary"
            android:text="Remover último golpe"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnSalvarDesafio"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/accent"
            android:text="Salvar desafio"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
