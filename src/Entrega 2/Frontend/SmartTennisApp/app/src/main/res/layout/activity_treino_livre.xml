<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <LinearLayout
        android:id="@+id/headerTreino"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:background="@color/surface_primary"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_back_button"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/setavoltar"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Treino Livre"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtEstadoConexao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_off"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="● Desconectado"
            android:textColor="@color/danger"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerTreino"
        app:layout_constraintBottom_toTopOf="@id/painelControles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seu ritmo. Sua evolução."
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:text="A raquete registra os golpes em tempo real."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_treino"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/txtEstadoTreino"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TREINO PARADO"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_accent_badge"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="SESSÃO AO VIVO"
                            android:textColor="@color/accent"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/surface_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TEMPO DE JOGO"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />
                            <TextView
                                android:id="@+id/txtCronometro"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="00:00"
                                android:textColor="@color/text_primary"
                                android:textSize="38sp"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/txtTotalGolpes"
                            android:layout_width="86dp"
                            android:layout_height="86dp"
                            android:background="@drawable/bg_total_golpes"
                            android:gravity="center"
                            android:text="0\nGOLPES"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="11dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SAQUES" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/txtSaques" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="11dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FOREHAND" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/txtForehands" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat_tile"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="11dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BACKHAND" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" />
                            <TextView android:id="@+id/txtBackhands" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0" android:textColor="@color/text_primary" android:textSize="23sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_primary"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_treino"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ÚLTIMO MOVIMENTO" android:textColor="@color/text_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
                    <TextView android:id="@+id/txtUltimoGolpe" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Aguardando primeiro golpe" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="13dp" android:layout_marginBottom="13dp" android:background="@color/surface_border" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/txtConfianca" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Confiança: --" android:textColor="@color/text_secondary" android:textSize="12sp" />
                            <TextView android:id="@+id/txtAceleracao" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="-- g" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Aceleração" android:textColor="@color/text_muted" android:textSize="11sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VELOCIDADE" android:textColor="@color/text_secondary" android:textSize="12sp" />
                            <TextView android:id="@+id/txtVelocidadeAngular" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="-- km/h" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Velocidade da raquete" android:textColor="@color/text_muted" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtGolpesNaoIdentificados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="Golpes não identificados: 0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/painelControles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_primary"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnIniciarTreino"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="@color/accent"
            android:text="▶  Iniciar treino"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPararTreino"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_secondary"
            android:enabled="false"
            android:text="■  Parar treino"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>


    <!-- Sinal visual de início: a sessão só começa após a contagem regressiva. -->
    <FrameLayout
        android:id="@+id/overlayInicioTreino"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E60F1620"
        android:clickable="true"
        android:focusable="true"
        android:elevation="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_start_signal_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="30dp"
            android:paddingEnd="24dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_accent_badge"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp"
                android:text="SMARTTENNIS · AO VIVO"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/txtStartSignalNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:text="3"
                android:textColor="@color/st_warning"
                android:textSize="92sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStartSignalMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:gravity="center"
                android:text="PREPARE-SE!"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Segure firme a raquete e prepare a posição."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
